{
  "name": "EnderPKG GitHub Actions starter",
  "files": [
    ".github/ISSUE_TEMPLATE/package-report.yml",
    ".github/workflows/community-voting.yml",
    ".github/workflows/package-reports.yml",
    ".github/workflows/validate-and-publish.yml",
    ".gitignore",
    "README.md",
    "scripts/common.py",
    "scripts/evaluate_votes.py",
    "scripts/merge_pr.py",
    "scripts/process_report.py",
    "scripts/publish.py",
    "scripts/validate_pr.py"
  ],
  "policy": {
    "approve_threshold": 10,
    "reject_threshold": 10,
    "reject_ratio": "2:1",
    "vote_check_interval_minutes": 30,
    "initial_status": "Potentially Unsafe",
    "normal_after_hours": 48,
    "reports": "warning flag; no automatic rejection",
    "package_dir": "packages/<slug>-<version>",
    "submission_rules": [
      "author == PR author",
      "slug == folder slug",
      "new (higher) version required",
      "slug owned by first publisher"
    ]
  }
}
